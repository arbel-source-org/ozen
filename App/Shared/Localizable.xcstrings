    "מפסיק את הכתוביות ושומר את השיחה בהיסטוריה.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ካፕሽኑን ያቆማል፣ ውይይቱንም በታሪክ ውስጥ ያስቀምጣል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقف الترجمة النصية ويحفظ المحادثة في السجل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppt die Untertitel und speichert das Gespräch im Verlauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops captions and saves the conversation in History."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detiene los subtítulos y guarda la conversación en el historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête les sous-titres et enregistre la conversation dans l’historique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैप्शन रोकता है और बातचीत को इतिहास में सहेजता है।"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para as legendas e guarda a conversa no histórico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Останавливает субтитры и сохраняет разговор в истории."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зупиняє субтитри й зберігає розмову в історії."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止字幕并将对话保存到历史记录中。"
          }
        }
      }
    },
