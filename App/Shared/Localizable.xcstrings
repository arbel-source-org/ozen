{
  "sourceLanguage": "he",
  "strings": {
    "אוזן אומרת את המשפט בקול רם, בעברית.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen ዓረፍተ ነገሩን ጮክ ብሎ ይናገራል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقول Ozen الجملة بصوت عالٍ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen spricht den Satz laut aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen says the sentence aloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen dice la frase en voz alta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen dit la phrase à voix haute."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen वाक्य को ज़ोर से बोलता है।"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Ozen diz a frase em voz alta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen произносит фразу вслух."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen промовляє фразу вголос."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen 会大声说出这句话。"
          }
        }
      }
    },
