    "פותח את אוזן במסך מלא באותיות גדולות, כדי שמישהו יכתוב לך.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሰው እንዲጽፍልዎት Ozenን በትልልቅ ፊደላት በሙሉ ማያ ይከፍታል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح Ozen بملء الشاشة بأحرف كبيرة، ليكتب لك أحدهم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Ozen im Vollbild mit großer Schrift, damit Ihnen jemand schreiben kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Ozen full screen in big letters, so someone can write to you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Ozen a pantalla completa con letras grandes, para que alguien te escriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Ozen en plein écran en grandes lettres, pour qu’on puisse vous écrire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen को बड़े अक्षरों में पूरी स्क्रीन पर खोलता है, ताकि कोई आपको लिखकर बता सके।"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Ozen em ecrã inteiro com letras grandes, para que alguém lhe possa escrever."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает Ozen на весь экран крупными буквами, чтобы вам могли написать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває Ozen на весь екран великими літерами, щоб вам могли написати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以大字全屏打开 Ozen，方便别人写给你看。"
          }
        }
      }
    },
    "פותח את אוזן ומתחיל להציג כתוביות לשיחה.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozenን ከፍቶ ለውይይቱ ካፕሽን ማሳየት ይጀምራል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح Ozen ويبدأ عرض الترجمة النصية للمحادثة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Ozen und zeigt Untertitel für das Gespräch an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Ozen and starts showing captions for the conversation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Ozen y empieza a mostrar los subtítulos de la conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Ozen et commence à afficher les sous-titres de la conversation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozen खोलता है और बातचीत के कैप्शन दिखाना शुरू करता है।"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Ozen e começa a mostrar legendas da conversa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает Ozen и начинает показывать субтитры разговора."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває Ozen і починає показувати субтитри розмови."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Ozen 并开始显示对话字幕。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
